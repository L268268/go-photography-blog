{{ define "modules/user/html/information" }}
    {{ template "templates/layouts/html/head".}}
    {{ template "templates/layouts/html/navbar".}}
    {{ template "templates/layouts/html/header".}}

    <!-- Begin Information
    ================================================== -->
    <div class="col-md-12 col-xs-12">
        <form class="article-form-container">
            <div class="form-group">
                <label class="h4 form-control-label">用户名</label>
                <div class="form-control">
                    {{ .user.Name }}
                </div>
            </div>
            <div class="form-group">
                <label class="h4 form-control-label">邮箱</label>
                <div class="form-control">
                    {{ .user.Email }}
                </div>
            </div>                  
                <a href="/information/edit" class="btn btn-primary">编辑个人信息</a>
            </div>
        </form>
    </div>
    <!-- End Information
    ================================================== -->

    {{ template "templates/layouts/html/footer".}}
    {{ template "templates/layouts/html/foot".}}
{{ end }}